programa {
  funcao inicio() {
    cadeia nome
    cadeia disciplina
    real notax
    real notay
   inteiro soma
   inteiro media

   escreva ("Digite seu nome ","\n")
    leia (nome)
   escreva ("Digite sua diciplina ","\n")
    leia (disciplina)
   escreva ("Digite primeiro nota","\n") 
    leia (notax)
   escreva ("Digite segunda nota","\n")
    leia (notay)
   
   soma = notax + notay
   media = soma /2
  
   escreva ("Seu nome �: ", nome, "\n")
   escreva ("Sua disciplina �: ", disciplina, "\n")
   escreva ("Sua primeira nota �: ", notax, "\n" )
   escreva ("Sua segunda nota �: ", notay, "\n" )
   escreva ("sua media �:", media, "\n" )
}
}
