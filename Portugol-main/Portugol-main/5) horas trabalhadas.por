programa {
  funcao inicio() {
     cadeia empresa
    const real normal = 10
    const real extra = 15
    real horanormal
    real horaextra
    real tHoran
    real thorae
    real salarioanual

escreva ("Digite nome da empresa ","\n")
    leia (empresa)
   escreva ("Digite horas trabalhadas anual","\n")
    leia (horanormal)
   escreva ("Digite horas extras trabalhadas anual","\n")
    leia (horaextra)

    tHoran = normal* horanormal
    thorae = extra * horaextra
    salarioanual = thorae + tHoran

    escreva ("Sua empresa �: ", empresa, "\n")
    escreva ("Voc� recebeu de horas trabalhadas por ano: ", tHoran, "\n")
    escreva ("Voc� recebeu de horas extras trabalhadas por ano: ", thorae, "\n")
    escreva ("Seu salario anual e : ", salarioanual, "\n")
  }
}
