programa {
  funcao inicio() 
  {
   cadeia nome 
   cadeia senha
   escreva("Digitite seu nome: ")
   leia(nome) 
   se(nome == "Luanda")
    escreva("Digitite sua senha: ")
   leia(senha) 
   se(nome == "Luanda" e senha == "12345")
   {
  escreva("Bem-vindo ao sitema ",nome,"\n")
}senao{
  escreva("Usuario nao cadrastrado")
}
}
}
