programa {
  funcao inicio() {
     inteiro x
    inteiro y
    real divisao
    real resto

    escreva ("Digite valor de x ","\n")
    leia (x)
   escreva ("Digite valor de y ","\n")
    leia (y)
  
  divisao = x/y
  resto = x%y
  escreva ( 
     x, "\ � o dividendo ", "\n",
     y ,"\ � o divisor ", "\n",
     divisao, "\ � quociente ", "\n",
     resto ,"\ � o resto","\n")
  }
}
